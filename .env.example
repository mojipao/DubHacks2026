# Copy to .env at the repo root. Never commit real values. Share the filled file privately.
# Full descriptions: planning/ARCHITECTURE.md, "Environment variables".

# Server
PORT=8787
# openssl rand -hex 24
OWNER_TOKEN=

# Supabase (the dedicated back-of-house project only)
SUPABASE_URL=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Web (also put these in apps/web/.env.local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# live | mock
NEXT_PUBLIC_DATA_MODE=mock
SERVER_URL=http://localhost:8787

# Photon 2.0 beta (project ID starts with pho_prj_)
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
# The shop's Photon iMessage line that customers text, E.164
PHOTON_AGENT_HANDLE=
# on only on the demo host; off | on | poll
PHOTON_INBOUND=off
# E.164 phone used by scripts/photon-ping.ts
PHOTON_TEST_SENDER=
# E.164 phone of the teammate playing the owner; only this handle can approve by text
OWNER_HANDLE=
# on | off
OWNER_NOTIFY=off

# Square sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Exact URL registered with Square, e.g. https://<ngrok-static-domain>/webhooks/square
SQUARE_WEBHOOK_URL=

# Agents
AI_GATEWAY_API_KEY=
AGENT_MODEL=
# live | stub
AGENT_MODE=stub

# Seed: persona=E.164 pairs, e.g. maya=+12065550100,jun=+12065550101
DEMO_PERSONAS=
