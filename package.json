{
  "name": "back-of-house",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @boh/server --filter @boh/web dev",
    "typecheck": "pnpm -r typecheck && tsc -p scripts",
    "build": "pnpm -r --if-present build",
    "seed": "tsx scripts/seed.ts",
    "reset": "tsx scripts/reset.ts",
    "demo:host": "tsx scripts/demo-host.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "dotenv": "^17.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
